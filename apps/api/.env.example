PORT=3000
CLOUDBASE_ENV_ID=writter-dev-d0g7h1prq4ce60665
WEB_ORIGIN=http://localhost:5173
# Every API runtime needs a full server-only backend key; implicit runtime credentials are unsupported.
# A masked key returned by the key list is not usable. Never expose a full key in the Web bundle.
CLOUDBASE_API_KEY=
# Required in production (at least 32 random characters). Keep stable across API restarts and key rotations.
CURSOR_SECRET=
# Optional: absolute path to this release's built Web directory for same-origin delivery.
# Leave empty when using Vite or a separate static host.
WEB_DIST_PATH=
